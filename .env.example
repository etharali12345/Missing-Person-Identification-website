# Frontend
VITE_API_URL=http://127.0.0.1:5000

# Backend application
SECRET_KEY=<flask-secret-key>
JWT_SECRET_KEY=<jwt-secret-key>
ADMIN_EMAIL=<admin-email-placeholder>
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>
MAIL_DEFAULT_SENDER=<smtp-sender>

# Backend database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=<mysql-user>
MYSQL_PASSWORD=<mysql-password>
MYSQL_DB=face_recognition_db

# Railway-compatible database names
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

# Seed accounts
SEED_USER_EMAIL=seed-user@example.invalid
SEED_USER_PASSWORD=<seed-user-password>
SEED_AUTHORITY_EMAIL=seed-authority@example.invalid
SEED_AUTHORITY_PASSWORD=<seed-authority-password>
SEED_ADMIN_EMAIL=seed-admin@example.invalid
SEED_ADMIN_PASSWORD=<seed-admin-password>
